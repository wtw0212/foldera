<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Used to open Finder's Get Info window (Properties). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Ad-hoc builds only: without a Team ID, library validation refuses the embedded Sparkle.framework.
	     Developer ID builds use Foldera.entitlements, which keeps library validation on. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
