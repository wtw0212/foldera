<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Used to open Finder's Get Info window (Properties). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Builds without a Team ID only (ad-hoc or the self-signed release certificate): library validation would
	     refuse the embedded Sparkle.framework. Developer ID builds use Foldera.entitlements, which keeps it on. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
