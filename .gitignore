# Xcode — build output lives in *.noindex folders so Spotlight and Launchpad don't list stray app copies
build/
build.noindex/
dist/
DerivedData/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcworkspace/xcuserdata/
*.xcuserstate
# Generated by XcodeGen — regenerate with `xcodegen generate`. Its Package.resolved is kept: it locks every
# Swift package (direct and transitive) to the versions Foldera is tested with, and builds refuse to drift from it.
Foldera.xcodeproj/*
!Foldera.xcodeproj/project.xcworkspace/
Foldera.xcodeproj/project.xcworkspace/*
!Foldera.xcodeproj/project.xcworkspace/xcshareddata/
Foldera.xcodeproj/project.xcworkspace/xcshareddata/*
!Foldera.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
Foldera.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!Foldera.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
# macOS
.DS_Store

# Personal signing settings
Config/Local.xcconfig

# Python CI-tool test caches
__pycache__/

# Exported Sparkle update-signing key (see RELEASING.md); never commit
sparkle-private-key
# Exported release signing certificate (see RELEASING.md); never commit
*.p12
